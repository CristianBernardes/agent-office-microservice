# Configuração do gateway — copie para .env (que não é versionado). Todas são obrigatórias.
# O gateway roda dentro da rede do docker-compose: hosts são os nomes dos serviços e as
# portas são as convencionais do container (as portas externas 70xx são só para o host/frontend).
MQTT_URL=tcp://mosquitto:1883
MQTT_CLIENT_ID=agent-office-gateway
MQTT_SUBSCRIBE_TOPIC=office/#
MQTT_QOS=1
KAFKA_BROKERS=kafka:9092
KAFKA_TOPIC_EVENTS=office.events
KAFKA_TOPIC_DLQ=office.events.dlq
KAFKA_TOPIC_PARTITIONS=3
REDIS_ADDR=redis:6379
DEDUPE_TTL=24h
DEDUPE_KEY_PREFIX=gw:event:
