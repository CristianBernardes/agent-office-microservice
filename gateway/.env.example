# Configuração do gateway — copie para .env (que não é versionado). Todas são obrigatórias.
# Valores abaixo servem para rodar o gateway no host; o docker-compose sobrescreve os hosts.
MQTT_URL=tcp://localhost:7083
MQTT_CLIENT_ID=agent-office-gateway
MQTT_SUBSCRIBE_TOPIC=office/#
MQTT_QOS=1
KAFKA_BROKERS=localhost:7092
KAFKA_TOPIC_EVENTS=office.events
KAFKA_TOPIC_DLQ=office.events.dlq
REDIS_ADDR=localhost:7079
DEDUPE_TTL=24h
DEDUPE_KEY_PREFIX=gw:event:
KAFKA_TOPIC_PARTITIONS=3
