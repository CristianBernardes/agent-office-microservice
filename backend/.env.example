# ─────────────────────────────────────────────────────────────────────────
# AgentOffice Backend — variáveis de ambiente
#
# Copie este arquivo para `.env` e ajuste os valores conforme seu ambiente.
# Os valores abaixo já funcionam "de fábrica" com o docker-compose.yml deste
# projeto (banco e broker). Apenas o Ollama precisa estar rodando no HOST,
# nunca em container (ver docs/adr/009-ollama-externo-ao-docker-compose.md).
# ─────────────────────────────────────────────────────────────────────────

# ─── Banco de Dados (PostgreSQL + pgvector) ────────────────────────────────
# Fora do Docker (execução local via Poetry), use a porta externa (7034).
# Dentro do Docker Compose, o backend usa o host interno "postgres:5432".
DATABASE_URL=postgresql://agm:agm@localhost:7034/agm

# ─── Barramento MQTT (Mosquitto) ───────────────────────────────────────────
# Valores para o container (rede do compose). Fora do Docker, use localhost e a porta externa (7083).
MQTT_HOST=mosquitto
MQTT_PORT=1883

# ─── Ollama — SEMPRE externo ao Docker Compose deste projeto ───────────────
# Este projeto é pensado para ser executado via 'make up' (Docker Compose).
# Nesse caso, o container do backend precisa do IP da bridge padrão do Docker
# para alcançar o Ollama rodando no seu host Linux — "localhost" dentro do
# container apontaria para o próprio container, não para o seu host.
# OBS: o docker-compose.yml já sobrescreve esta variável automaticamente com
# este mesmo valor; ela é repetida aqui apenas para que o backend também
# funcione corretamente se for executado localmente (fora de container) na
# mesma máquina. Se você rodar o backend fora do Docker E o Ollama não
# responder neste endereço, troque para http://localhost:11434.
OLLAMA_BASE_URL=http://172.17.0.1:11434
OLLAMA_MODEL=nemotron-3.5-bolt:latest
# Tempo máximo (s) de uma chamada ao Ollama; modelos locais com vários agentes são lentos.
OLLAMA_REQUEST_TIMEOUT_SECONDS=600
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest

# Idioma do escritório: pt | en (prompts dos agentes e mensagens de erro padrão)
OFFICE_LANGUAGE=en

# Modelo por papel (opcional). Vazio = usa OLLAMA_MODEL.
AGENT_PO_MODEL=qwen3.6:latest
AGENT_SM_MODEL=gpt-oss:20b
AGENT_TECH_LEAD_MODEL=qwen3.6:latest
AGENT_DEV_SENIOR_MODEL=nemotron-3.5-bolt:latest
AGENT_DEV_JUNIOR_MODEL=gpt-oss:20b
AGENT_QA_MODEL=sorc/qwen3.5-claude-4.6-opus:latest
AGENT_DATA_MODEL=nemotron3:latest
AGENT_HR_MODEL=gpt-oss:20b
AGENT_CONSULTANT_MODEL=sorc/qwen3.5-claude-4.6-opus:latest

# ─── Busca Web (Tavily) ─────────────────────────────────────────────────────
# Usada pela ferramenta `web_search` de alguns papéis (PO, Tech Lead, Devs,
# Analista de Dados, Consultor — ver docs/migration-plan/fase-3-personas/).
# Chave PESSOAL e PAGA (camada gratuita de 1000 buscas/mês) — NÃO preencha
# este arquivo com uma chave real. Obtenha a sua gratuitamente em
# https://app.tavily.com e coloque-a apenas no seu `.env` local, nunca aqui.
TAVILY_API_KEY=
TAVILY_SEARCH_URL=https://api.tavily.com/search
TAVILY_TIMEOUT_SECONDS=30

# ─── API HTTP do backend ────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# Persistência: memory (padrão, volátil) | postgres (ADR-014)
PERSISTENCE_BACKEND=memory

# Barramento de mensagens: memory | mqtt (ADR-021)
MESSAGE_BUS_BACKEND=memory

# CORS: origens do frontend, separadas por vírgula (ADR-015)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Autonomia: agentes reagem a objetivos (ADR-022)
AUTONOMY_ENABLED=false
# Rodadas de debate por reunião de objetivo (1-5)
MEETING_ROUNDS=1
# Escritório vivo: intervalo (s) do ciclo que move as tarefas do Kanban (0 = desligado; ADR-048)
SPRINT_MAX_DAYS=15
WORK_LOOP_INTERVAL_SECONDS=0
