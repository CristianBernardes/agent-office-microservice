# Variáveis do docker-compose (interpolação) — copie para .env (não versionado).
# Segredos e portas externas ficam aqui; dentro dos containers valem as portas convencionais.
POSTGRES_DB=agm
POSTGRES_USER=agm
POSTGRES_PASSWORD=agm

# Portas expostas no host (frontend/ferramentas); o container usa as convencionais.
HOST_PORT_MQTT=7083
HOST_PORT_MQTT_WS=7000
HOST_PORT_POSTGRES=7034
HOST_PORT_BACKEND=7001
HOST_PORT_REDIS=7079
HOST_PORT_KAFKA=7092

# Ollama roda no host, fora do compose (ADR-009); alcançado pela bridge do Docker.
OLLAMA_URL_IN_CONTAINER=http://172.17.0.1:11434
