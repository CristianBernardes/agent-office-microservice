# Configuração do frontend — copie para .env (não versionado). Todas são obrigatórias, exceto VITE_PAYPAL_URL.
# O navegador usa as portas EXTERNAS do host (ver .env da raiz); dentro de containers valem as convencionais.
VITE_API_URL=http://localhost:7001
VITE_MQTT_WS_URL=ws://localhost:7000
VITE_DEFAULT_LANGUAGE=pt
VITE_PIX_LABEL=Pix
# Modelo Ollama sugerido ao contratar um agente.
VITE_DEFAULT_LLM_MODEL=qwen3.6:latest
# Doação: PayPal é opcional (vazio = botão oculto); intervalo em dias entre lembretes (0 = sempre que abrir).
VITE_PAYPAL_URL=https://www.paypal.com/donate/?business=cristian.aob%40gmail.com&item_name=Support+the+AgentOffice+project&currency_code=USD
VITE_DONATION_REMINDER_DAYS=7
# Intervalo (ms) de atualização das conversas e tarefas via REST.
VITE_REFRESH_INTERVAL_MS=5000
# Intervalo (ms) entre caminhadas/conversas dos agentes no mapa (0 = parados)
VITE_WANDER_INTERVAL_MS=8000
# Limites de WIP por coluna do Kanban (0 = sem limite)
VITE_WIP_LIMIT_TODO=0
VITE_WIP_LIMIT_IN_PROGRESS=5
VITE_WIP_LIMIT_IN_REVIEW=3
